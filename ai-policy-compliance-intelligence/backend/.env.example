# ==========================================
# AI Policy Compliance Intelligence Backend
# ==========================================
# Copy this file to .env or fill backend/.env directly.
# The backend runs in local fallback mode without external keys.

# ---------------- App ----------------
APP_NAME="AI-Powered Policy Compliance Intelligence Assistant"
APP_VERSION="1.0.0"
ENVIRONMENT="local"
API_PREFIX="/api/v1"
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# Comma-separated list is supported.
CORS_ORIGINS="http://localhost:3000,http://localhost:5173"

# ---------------- Local Data ----------------
# These can stay as defaults unless you want custom folders.
DATA_DIR="data"
RAW_DIR="data/raw"
PROCESSED_DIR="data/processed"
EMBEDDINGS_DIR="data/embeddings"

# ---------------- LLM / Embeddings ----------------
# Required only if you switch providers from local to openrouter.
LLM_PROVIDER="local"
EMBEDDING_PROVIDER="local"
OPENROUTER_API_KEY=""
OPENROUTER_BASE_URL="https://openrouter.ai/api/v1"
OPENROUTER_MODEL="openai/gpt-4o-mini"
OPENROUTER_EMBEDDING_MODEL="openai/text-embedding-3-small"
OPENROUTER_SITE_URL="http://localhost:8000"
OPENROUTER_APP_NAME="AI Policy Compliance Intelligence"

# ---------------- Document Store ----------------
# local = JSON file storage. mongodb = MongoDB Atlas/local MongoDB.
DOCUMENT_STORE_PROVIDER="local"
MONGODB_URI=""
MONGODB_DATABASE="policy_compliance"

# ---------------- Cache ----------------
# local = in-memory cache. upstash = Upstash Redis REST API.
CACHE_PROVIDER="local"
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ---------------- Knowledge Graph ----------------
# local = lightweight relationship map. neo4j = Neo4j Aura/local Neo4j.
GRAPH_PROVIDER="local"
NEO4J_URI=""
NEO4J_USER=""
NEO4J_PASSWORD=""

# ---------------- Vector Store ----------------
# local = deterministic local embeddings/search. weaviate = Weaviate Cloud/local.
VECTOR_STORE_PROVIDER="local"
WEAVIATE_URL=""
WEAVIATE_API_KEY=""
WEAVIATE_COLLECTION="PolicyChunk"

# ---------------- Runtime Limits ----------------
MAX_UPLOAD_MB=25
CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=6
RISK_THRESHOLD_HIGH=0.72
RISK_THRESHOLD_MEDIUM=0.42

# ---------------- Link Scraping ----------------
# When enabled, ingested documents are scanned for links and readable web text is indexed as extra evidence.
ENABLE_LINK_SCRAPING=true
SCRAPE_TIMEOUT_SECONDS=8
MAX_SCRAPED_LINKS=5
MAX_SCRAPED_CHARS_PER_LINK=5000
